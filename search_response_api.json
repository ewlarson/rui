{"jsonapi":{"version":"1.1","profile":["https://gin.btaa.org/api/v1/ld/profiles/ogm-b1g.profile.jsonld","https://gin.btaa.org/api/v1/ld/profiles/ogm-ui.profile.jsonld"]},"links":{"self":"http://localhost:8000/api/v1/search?search_field=all_fields&page=1&per_page=1","next":"http://localhost:8000/api/v1/search?search_field=all_fields&page=2&per_page=1","first":"http://localhost:8000/api/v1/search?search_field=all_fields&page=1&per_page=1","last":"http://localhost:8000/api/v1/search?search_field=all_fields&page=143691&per_page=1"},"meta":{"totalCount":143691,"totalPages":143691,"currentPage":1,"perPage":1,"query":"","sort":null,"queryTime":{"elasticsearch":"386ms","resourceProcessing":{"total":"37ms","perResource":"37ms","thumbnailService":"0ms","citationService":"0ms","viewerService":"1ms"},"totalResponseTime":"426ms"},"spellingSuggestions":[]},"data":[{"type":"resource","id":"8ef0f4af47974b9595472467ae2b104d_1","attributes":{"ogm":{"id":"8ef0f4af47974b9595472467ae2b104d_1","dct_title_s":"Building Footprints [Illinois--Lake County]","dct_alternative_sm":["Building Footprints"],"dct_description_sm":["Download In State Plane Projection Here . The pavement boundaries were traced from aerial photography taken between April 13 and April 26, 2002 and then updated from photography taken between March 15 and April 25, 2018. This dataset should meet National Map Accuracy Standards for a 1:1200 product. Lake County staff reviewed this dataset to ensure completeness and correct classification. In the case of a divided highway, the pavement on each side is captured separately. Island features in cul-de-sacs and in roads are included as a separate polygon. These building outlines were traced from aerial photography taken between April 13 and April 26, 2002 and then updated from successive years of photography. The most recent aerial photography was flown between March 11 and April 12, 2017. This dataset should meet National Map Accuracy Standards for a 1:1200 product. All the enclosed structures in Lake County with an area larger than 100 square feet as of April 2014 should be represented in this coverage. It should also be noted that a single polygon in this dataset could be composed of many structures that share walls or are otherwise touching. For example, a shopping mall may be captured as one polygon. Note that the roof area boundary is often not identical to the building footprint at ground level. Contributors to this dataset include: Municipal GIS Partners, Inc., Village of Gurnee, Village of Vernon Hills."],"dct_language_sm":["eng"],"gbl_displayNote_sm":["Tip: Check “Visit Source” link for download options."],"dct_creator_sm":["Lake County Illinois GIS"],"gbl_resourceClass_sm":["Web services"],"gbl_resourceType_sm":["Polygon data"],"dcat_theme_sm":["Structure"],"dcat_keyword_sm":["LakeCountyIllinois","planimetrics","buildings","outlines","rooflines","PlanimetricsandLandmarks","planimetricsandlandmarksSpatialData"],"dct_temporal_sm":["Last Modified: 2025-08-24"],"dct_issued_s":"2016-11-17","gbl_indexYear_im":[2025],"gbl_dateRange_drsim":["2025-2025"],"dct_spatial_sm":["Illinois--Lake County","Illinois"],"locn_geometry":"POLYGON((-88.200 42.498, -87.760 42.498, -87.760 42.152, -88.200 42.152, -88.200 42.498))","dcat_bbox":"-88.200,42.152,-87.760,42.498","dcat_centroid":"42.325,-87.98","pcdm_memberOf_sm":["ba5cc745-21c5-4ae9-954b-72dd8db6815a"],"dct_isPartOf_sm":["12b-17097"],"dct_rights_sm":["https://www.arcgis.com/sharing/rest/content/items/89679671cfa64832ac2399a0ef52e414/data"],"dct_accessRights_s":"Public","dct_format_s":"ArcGIS FeatureLayer","dct_references_s":"{\"urn:x-esri:serviceType:ArcGIS#FeatureLayer\": \"https://services3.arcgis.com/HESxeTbDliKKvec2/arcgis/rest/services/LakeCounty_Planimetrics/FeatureServer/1\", \"http://schema.org/url\": \"https://data-lakecountyil.opendata.arcgis.com/datasets/lakecountyil::building-footprints\"}","dct_identifier_sm":["https://hub.arcgis.com/datasets/8ef0f4af47974b9595472467ae2b104d_1"],"g